@inject ToastService ToastSvc
@implements IDisposable

@if (_visible)
{
    <div style="position:fixed;bottom:80px;left:50%;transform:translateX(-50%);
                z-index:9999;padding:10px 20px;border-radius:20px;
                font-size:13px;font-weight:500;color:#fff;
                background:@_bg;
                box-shadow:0 4px 20px rgba(0,0,0,.45);
                max-width:82%;text-align:center;pointer-events:none;
                animation:toast-in .2s ease;">
        @_icon @_message
    </div>
}

@code {
    private bool _visible;
    private string _message = "";
    private string _icon = "";
    private string _bg = "#333";
    private CancellationTokenSource? _cts;

    protected override void OnInitialized()
    {
        ToastSvc.OnShow += HandleShow;
    }

    private void HandleShow(ToastMessage msg)
    {
        _message = msg.Text;
        (_icon, _bg) = msg.Type switch
        {
            ToastType.Success => ("✓", "rgba(34,120,60,.95)"),
            ToastType.Error   => ("⚠", "rgba(180,50,50,.95)"),
            _                 => ("⇅", "rgba(25,35,55,.94)")
        };

        _cts?.Cancel();
        _cts = new CancellationTokenSource();
        _visible = true;
        _ = InvokeAsync(StateHasChanged);

        var token = _cts.Token;
        _ = Task.Delay(3000, token).ContinueWith(_ =>
        {
            if (!token.IsCancellationRequested)
            {
                _visible = false;
                _ = InvokeAsync(StateHasChanged);
            }
        }, TaskScheduler.Default);
    }

    public void Dispose()
    {
        ToastSvc.OnShow -= HandleShow;
        _cts?.Cancel();
    }
}
