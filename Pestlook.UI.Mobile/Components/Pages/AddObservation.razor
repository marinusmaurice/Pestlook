@page "/add-obs/{SessionId}"
@inject LocalDatabase Db
@inject GpsService Gps
@inject NavigationManager Nav

<div class="app-shell">
    <!-- App bar -->
    <div class="ab">
        <button class="ab-btn" @onclick="Cancel">✕ Cancel</button>
        <span class="ab-title">Add observation</span>
        <div style="width:52px;"></div>
    </div>

    <div class="app-body">
        @if (!string.IsNullOrEmpty(error))
        {
            <div class="error-box">@error</div>
        }

        <!-- Capture type -->
        <div class="sl">Capture type</div>
        <div class="seg">
            <button class="seg-btn @(captureMode == 0 ? "on" : "")" @onclick="() => SetCaptureMode(0)">Count</button>
            <button class="seg-btn @(captureMode == 1 ? "on" : "")" @onclick="() => SetCaptureMode(1)">Present / absent</button>
        </div>

        <!-- Pest selector -->
        @if (true)
        {
            <div class="sl">Pest</div>
            @if (pestsLoading)
            {
                <div class="loading-center"><span class="spinner-sm"></span></div>
            }
            else
            {
                <div style="margin:4px 10px;">
                    <select class="pk-select" @bind="selectedPestId" @bind:after="OnPestChanged">
                        <option value="">Select a pest...</option>
                        @foreach (var p in pests)
                        {
                            <option value="@p.Id">@PestEmoji(p.Category) @p.CommonName</option>
                        }
                    </select>
                </div>
                @if (thresholdCount.HasValue)
                {
                    <div style="margin:0 10px 2px;font-size:11px;color:var(--text-dim);">Alert threshold: @thresholdCount</div>
                }
            }
        }

        <!-- Count -->
        @if (captureMode == 0)
        {
            <div class="sl">Count</div>
            <div style="display:flex;align-items:center;gap:14px;padding:6px 12px;">
                <button class="cb" style="width:40px;height:40px;font-size:20px;" @onclick="() => { if (count > 0) count--; }">−</button>
                <span style="font-size:30px;font-weight:600;min-width:52px;text-align:center;color:@(thresholdCount.HasValue && count > thresholdCount.Value ? "var(--red)" : "var(--text)");">@count</span>
                <button class="cb" style="width:40px;height:40px;font-size:20px;" @onclick="() => count++">+</button>
                @if (thresholdCount.HasValue)
                {
                    <div style="flex:1;">
                        @if (count > thresholdCount.Value)
                        {
                            <div style="font-size:12px;font-weight:600;color:var(--red);">⚠ Exceeds limit (@thresholdCount)</div>
                        }
                        else
                        {
                            <div style="font-size:12px;color:var(--text-dim);">Limit: @thresholdCount</div>
                        }
                    </div>
                }
            </div>
        }

        <!-- Present / absent -->
        @if (captureMode == 1)
        {
            <div class="sl">Status</div>
            <div class="seg" style="margin:4px 10px;">
                <button class="seg-btn @(present ? "on" : "")" @onclick="() => present = true">Present</button>
                <button class="seg-btn @(!present ? "on" : "")" @onclick="() => present = false">Absent</button>
            </div>
        }

        <!-- Life stage -->
        <div class="sl">Life stage <span style="font-weight:400;text-transform:none;letter-spacing:0;">(optional)</span></div>
        <div style="margin:4px 10px;">
            <select class="pk-select" @bind="selectedLifeStage">
                <option value="-1">Not specified</option>
                <option value="0">Egg</option>
                <option value="1">Larva / Nymph</option>
                <option value="2">Pupa</option>
                <option value="3">Adult</option>
            </select>
        </div>

        <!-- Trap (optional) -->
        @if (traps.Count > 0)
        {
            <div class="sl">Trap <span style="font-weight:400;text-transform:none;letter-spacing:0;">(optional)</span></div>
            <div style="margin:4px 10px;">
                <select class="pk-select" @bind="selectedTrapId">
                    <option value="">No trap selected</option>
                    @foreach (var t in traps)
                    {
                        <option value="@t.Id">🕸️ @t.Name@(!string.IsNullOrEmpty(t.Barcode) ? $" · {t.Barcode}" : "")</option>
                    }
                </select>
            </div>
        }

        <!-- GPS -->
        <div class="sl">GPS location</div>
        <div class="cd" style="display:flex;align-items:center;gap:8px;padding:10px 12px;">
            <span style="font-size:15px;">📍</span>
            <div style="flex:1;">
                @if (gpsLat.HasValue && gpsLng.HasValue)
                {
                    <div style="font-size:12px;font-weight:500;">@gpsLat.Value.ToString("F4"), @gpsLng.Value.ToString("F4")</div>
                    <div style="font-size:11px;color:var(--text-dim);">Live location</div>
                }
                else
                {
                    <div style="font-size:12px;color:var(--text-dim);">@gpsStatus</div>
                }
            </div>
            @if (gpsLat.HasValue)
            {
                <span class="ch cs">OK</span>
            }
            else
            {
                <button class="bo" style="padding:4px 10px;font-size:11px;" @onclick="GetGps">📍 Get</button>
            }
        </div>

        <!-- Notes -->
        <div class="sl">Notes <span style="font-weight:400;text-transform:none;letter-spacing:0;">(optional)</span></div>
        <div style="margin:4px 10px;">
            <textarea class="inp" placeholder="Field observations..." rows="4" style="resize:none;height:auto;" @bind="notes"></textarea>
        </div>
    </div>

    <!-- Bottom -->
    <div style="padding:8px 10px;border-top:.5px solid var(--border);flex-shrink:0;">
        <button class="bp" style="margin:0;width:100%;" @onclick="Save" disabled="@saving">
            @if (saving) { <span class="spinner-sm"></span> } Save observation
        </button>
    </div>
</div>

@code {
    [Parameter] public string SessionId { get; set; } = "";

    private LocalSession? session;
    private List<CachedPest> pests = new();
    private List<CachedTrap> traps = new();
    private bool pestsLoading = true;
    private string selectedPestId = "";
    private string selectedTrapId = "";
    private int captureMode;
    private int count;
    private int? thresholdCount;
    private bool present = true;
    private int selectedLifeStage = -1;
    private string notes = "";
    private string? error;
    private bool saving;
    private double? gpsLat;
    private double? gpsLng;
    private string gpsStatus = "Tap Get to capture location";

    protected override async Task OnInitializedAsync()
    {
        await Db.InitAsync();
        session = await Db.GetSessionAsync(SessionId);
        pests = await Db.GetCachedPestsAsync();
        traps = await Db.GetEnabledTrapsAsync();
        pestsLoading = false;
        _ = GetGps();
    }

    private void SetCaptureMode(int mode)
    {
        captureMode = mode;
        if (captureMode != 0)
        {
            thresholdCount = null;
        }
        else
        {
            var sel = pests.FirstOrDefault(p => p.Id == selectedPestId);
            thresholdCount = sel?.AlertThreshold;
        }
    }

    private void OnPestChanged()
    {
        var sel = pests.FirstOrDefault(p => p.Id == selectedPestId);
        thresholdCount = captureMode == 0 ? sel?.AlertThreshold : null;
    }

    private async Task GetGps()
    {
        gpsStatus = "Getting location...";
        StateHasChanged();
        try
        {
            var loc = await Gps.GetCurrentLocationAsync();
            if (loc.lat != 0 || loc.lng != 0)
            {
                gpsLat = loc.lat;
                gpsLng = loc.lng;
                gpsStatus = "Location captured";
            }
            else
            {
                gpsStatus = "Location unavailable";
            }
        }
        catch
        {
            gpsStatus = "Location unavailable";
        }
        StateHasChanged();
    }

    private async Task Save()
    {
        error = null;

        if (string.IsNullOrEmpty(selectedPestId))
        {
            error = "Please select a pest.";
            return;
        }

        saving = true;
        StateHasChanged();

        var selectedPest = pests.FirstOrDefault(p => p.Id == selectedPestId);
        var isUnknown = selectedPest?.CommonName == "Unknown";
        var pestId = selectedPestId;
        var pestName = selectedPest?.CommonName;
        var trapId = string.IsNullOrEmpty(selectedTrapId) ? null : selectedTrapId;
        var trapName = trapId is null ? null : traps.FirstOrDefault(t => t.Id == trapId)?.Name;
        var lifeStage = selectedLifeStage >= 0 ? selectedLifeStage : (int?)null;

        // Always save locally; SyncService will push to the server on next sync
        var localObs = new LocalObservation
        {
            SessionId = SessionId,
            PestId = pestId,
            PestName = pestName,
            IsUnknownPest = isUnknown,
            CaptureMode = captureMode,
            Count = captureMode == 0 ? count : null,
            IsPresent = captureMode == 1 ? present : null,
            TrapId = trapId,
            TrapName = trapName,
            CapturedLat = gpsLat,
            CapturedLng = gpsLng,
            Notes = string.IsNullOrWhiteSpace(notes) ? null : notes.Trim(),
            LifeStage = lifeStage,
            ThresholdCount = captureMode == 0 ? thresholdCount : null,
            IsPlanned = false,
            IsDirty = true
        };
        await Db.SaveObservationAsync(localObs);

        saving = false;
        Nav.NavigateTo($"/session-detail/{SessionId}");
    }

    private void Cancel() => Nav.NavigateTo($"/session-detail/{SessionId}");

    private static string PestEmoji(int cat) => cat switch { 0 => "🦟", 1 => "🦠", 2 => "🌿", 3 => "🐀", _ => "❓" };
}
