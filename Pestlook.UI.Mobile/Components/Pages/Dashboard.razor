@page "/home"
@inject ApiClient Api
@inject LocalDatabase Db
@inject SyncService Sync
@inject ConnectivityService Conn
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

<div class="app-shell">
    <!-- App bar -->
    <div class="ab">
        <div class="ib">🐛</div>
<span class="ab-title" @onclick="ToggleDebug">Pestlook</span>
        <div style="width:48px;"></div>
    </div>

    <!-- Offline indicator -->
    @if (!Conn.IsOnline)
    {
        <div class="bn">
            <span style="font-size:13px;">📡</span>
            <span style="font-size:12px;color:var(--amber);">Offline — data saved locally</span>
        </div>
    }

    @if (pendingSessions.Count > 0)
    {
        <div class="sync-row">
            <span style="font-size:13px;">📤</span>
            <div style="flex:1;">
                <div style="font-size:12px;font-weight:600;color:var(--amber);">@pendingSessions.Count sessions pending upload</div>
                <div style="font-size:11px;color:var(--text-dim);">@syncStatus</div>
            </div>
            <button class="bo" style="padding:5px 10px;font-size:12px;color:var(--amber);border-color:rgba(240,168,64,.3);"
                    @onclick="SyncNow" disabled="@Sync.IsSyncing">
                @if (Sync.IsSyncing) { <span class="spinner-sm" style="width:12px;height:12px;margin-right:4px;"></span> }Sync now
            </button>
        </div>
    }

    <div class="app-body">
        <!-- Greeting -->
        <div style="padding:16px 12px 8px;">
            <div style="font-size:18px;font-weight:600;color:#fff;">@greeting, @userName</div>
            <div style="font-size:12px;color:var(--text-dim);margin-top:2px;">@DateTime.Now.ToString("dddd, d MMMM yyyy")</div>
        </div>

        <!-- Start session -->
        <button class="bp" @onclick="StartNewSession">🥾 Start new session →</button>

        @if (loading)
        {
            <div class="loading-center"><span class="spinner-sm"></span> Loading...</div>
        }
        else
        {
            <!-- Active sessions -->
            @if (activeSessions.Count > 0)
            {
                <div class="sl">Active sessions</div>
                @foreach (var s in activeSessions)
                {
                    <div class="sess-card" style="border-color:rgba(109,222,132,.25);"
                         @onclick="() => OpenSession(s)">
                        <div class="sess-head" style="background:var(--green-glow);">
                            <span style="font-size:16px;">🌾</span>
                            <div style="flex:1;">
                                <div style="font-size:13px;font-weight:600;color:var(--green);">@(s.FarmName ?? "Session") · @s.StartedAt.ToLocalTime().ToString("d MMM")</div>
                                <div style="font-size:11px;color:var(--text-dim);">Started @s.StartedAt.ToLocalTime().ToString("HH:mm")</div>
                            </div>
                            <span class="ch cs">● Live</span>
                        </div>
                        <div class="sess-stats">
                            <div class="sess-stat">
                                <div style="font-size:16px;font-weight:600;">@(obsCounts.GetValueOrDefault(s.Id, 0))</div>
                                <div style="font-size:10px;color:var(--text-dim);">Observations</div>
                            </div>
                            <div class="sess-stat">
                                <div style="font-size:16px;font-weight:600;">@(s.WeatherCondition ?? "—")</div>
                                <div style="font-size:10px;color:var(--text-dim);">Weather</div>
                            </div>
                        </div>
                    </div>
                }
            }

            <!-- Planned sessions -->
            @if (plannedSessions.Count > 0)
            {
                <div class="sl">Planned sessions</div>
                @foreach (var s in plannedSessions)
                {
                    <div class="rw" style="cursor:pointer;" @onclick="() => OpenSession(s)">
                        <span style="font-size:16px;">📋</span>
                        <div style="flex:1;margin-left:8px;">
                            <div style="font-size:13px;font-weight:600;">@(s.FieldName ?? s.FarmName ?? "Session")</div>
                            <div style="font-size:11px;color:var(--text-dim);">@(s.ScheduledDate.HasValue ? s.ScheduledDate.Value.ToLocalTime().ToString("d MMM yyyy") : "No date") · @(obsCounts.GetValueOrDefault(s.Id, 0)) obs</div>
                        </div>
                        <span class="ch" style="background:rgba(100,160,240,.12);color:#64a0f0;border:.5px solid rgba(100,160,240,.3);">Planned</span>
                    </div>
                }
            }

            <!-- Sync queue -->
            @if (pendingSessions.Count > 0)
            {
                <div class="sl">Sync queue</div>
                <div class="cd" style="padding:0;overflow:hidden;">
                    @foreach (var s in pendingSessions)
                    {
                        <div class="obs-item">
                            <span style="font-size:15px;">🗂</span>
                            <div style="flex:1;">
                                <div style="font-size:12px;font-weight:600;">@(s.FarmName ?? "Session") · @s.StartedAt.ToLocalTime().ToString("d MMM HH:mm")</div>
                                <div style="font-size:11px;color:var(--text-dim);">@(obsCounts.GetValueOrDefault(s.Id, 0)) obs</div>
                            </div>
                            <span class="ch cw">Queued</span>
                        </div>
                    }
                </div>
            }

            <!-- Trap map -->
            @if (locatedTraps.Count > 0)
            {
                <div class="sl" style="display:flex;align-items:center;justify-content:space-between;">
                    <span>Trap map</span>
                    <span style="font-size:11px;font-weight:400;text-transform:none;letter-spacing:0;color:var(--text-dim);cursor:pointer;" @onclick='() => Nav.NavigateTo("/trap-map")'>View all →</span>
                </div>
                <div id="dash-trap-map" style="margin:0 10px 8px;border-radius:10px;overflow:hidden;border:.5px solid var(--border);height:220px;"></div>
            }
        }
    </div>

    <!-- Trap info sheet -->
    @if (selectedTrap is not null)
    {
        <div style="position:fixed;inset:0;z-index:999;" @onclick="() => selectedTrap = null"></div>
        <div style="position:fixed;bottom:0;left:0;right:0;z-index:1000;background:var(--surface);border-top:.5px solid var(--border);border-radius:16px 16px 0 0;padding:16px 16px 40px;box-shadow:0 -6px 32px rgba(0,0,0,.45);">
            <!-- Header -->
            <div style="display:flex;align-items:center;gap:12px;margin-bottom:10px;">
                <div style="width:44px;height:44px;border-radius:12px;background:@(selectedTrap.IsEnabled ? "rgba(109,222,132,.12)" : "rgba(224,96,96,.12)");display:flex;align-items:center;justify-content:center;font-size:22px;flex-shrink:0;">🕸️</div>
                <div style="flex:1;">
                    <div style="font-size:15px;font-weight:600;">@selectedTrap.Name</div>
                    @if (!string.IsNullOrEmpty(selectedTrap.Barcode))
                    {
                        <div style="font-size:11px;color:var(--text-dim);">🏷 @selectedTrap.Barcode</div>
                    }
                </div>
                <button class="ib" @onclick="() => selectedTrap = null" @onclick:stopPropagation>✕</button>
            </div>
            <!-- Chips -->
            <div style="display:flex;gap:6px;margin-bottom:10px;flex-wrap:wrap;">
                <span class="ch @(selectedTrap.IsEnabled ? "cs" : "ce")" style="font-size:10px;">@(selectedTrap.IsEnabled ? "Enabled" : "Disabled")</span>
                @if (!string.IsNullOrEmpty(selectedTrap.TrapTypeName))
                {
                    <span class="ch cn" style="font-size:10px;">@selectedTrap.TrapTypeName</span>
                }
            </div>
            <!-- Coords -->
            @if (selectedTrap.Latitude.HasValue && selectedTrap.Longitude.HasValue)
            {
                <div style="font-size:11px;color:var(--text-dim);margin-bottom:12px;">📍 @selectedTrap.Latitude.Value.ToString("F5"), @selectedTrap.Longitude.Value.ToString("F5")</div>
            }
            @if (!string.IsNullOrEmpty(selectedTrap.Notes))
            {
                <div style="font-size:12px;color:var(--text-dim);margin-bottom:12px;">@selectedTrap.Notes</div>
            }
            <!-- Action -->
            <button class="bp" style="margin:0;width:100%;" @onclick="ViewSelectedTrap">View full details →</button>
        </div>
    }

    <!-- Sync section -->
    <div style="padding:8px 10px;border-top:.5px solid var(--border);display:flex;flex-direction:column;align-items:center;">
        @if (syncError is not null)
        {
            <div style="font-size:11px;color:var(--red,#e87070);margin-bottom:6px;padding:6px 8px;background:rgba(232,112,112,.1);border-radius:6px;width:100%;text-align:center;">⚠ @syncError</div>
        }
        @if (Conn.IsOnline)
        {
            <button class="bp" style="min-width:140px;" @onclick="SyncNow" disabled="@syncing">
                @if (syncing)
                {
                    <span class="spinner-sm" style="width:14px;height:14px;margin-right:6px;"></span>
                    <span>@syncStatus</span>
                }
                else
                {
                    <span>⇅ Sync</span>
                }
            </button>
        }
        else
        {
            <div style="font-size:11px;color:var(--text-dim);text-align:center;">Offline — connect to sync</div>
        }
    </div>

@if (_isDebug && _debugExpanded)
{
    <div style="margin:8px 10px;padding:10px;background:rgba(0,0,0,.55);border:.5px solid rgba(255,255,100,.25);border-radius:8px;font-size:10px;font-family:monospace;color:#e0e060;max-height:260px;overflow-y:auto;">
        <div style="font-weight:700;margin-bottom:6px;color:#ffe;font-size:11px;">🔍 Debug Log <span style="float:right;cursor:pointer;" @onclick="() => _debugLines.Clear()">clear</span></div>
        @foreach (var line in _debugLines)
        {
            <div style="border-bottom:.5px solid rgba(255,255,255,.08);padding:2px 0;">@line</div>
        }
        @if (_debugLines.Count == 0)
        {
            <div style="color:var(--text-dim);">No log entries yet. Tap the title to refresh.</div>
        }
    </div>
}

    <!-- Tab bar -->
    <TabBar ActiveTab="home" />
</div>

@code {
    private string greeting = "Hello";
    private string userName = "Scout";
    private string syncStatus = "";
    private string? syncError;
    private bool syncing;
    private bool loading = true;
    private List<LocalSession> activeSessions = new();
    private List<LocalSession> plannedSessions = new();
    private List<LocalSession> pendingSessions = new();
    private Dictionary<string, int> obsCounts = new();
    private List<CachedTrap> locatedTraps = new();
    private CachedTrap? selectedTrap;
    private bool _mapInitialized;
    private DotNetObjectReference<Dashboard>? _dotNetRef;
#if DEBUG
    private readonly bool _isDebug = true;
    private bool _debugExpanded;
    private readonly List<string> _debugLines = new();
    private void ToggleDebug() { _debugExpanded = !_debugExpanded; StateHasChanged(); }
    private void Log(string msg) => _debugLines.Add($"[{DateTime.Now:HH:mm:ss.fff}] {msg}");
#else
    private readonly bool _isDebug = false;
    private void ToggleDebug() { }
    private void Log(string msg) { }
#endif

    protected override async Task OnInitializedAsync()
    {
        if (!Api.IsLoggedIn) { Nav.NavigateTo("/"); return; }

        var hour = DateTime.Now.Hour;
        greeting = hour < 12 ? "Morning" : hour < 17 ? "Afternoon" : "Evening";
        userName = Api.CurrentUser?.FirstName ?? "Scout";

        Conn.OnConnectivityChanged += OnConnChanged;
        Sync.OnProgress += OnSyncProgress;
        Sync.OnCompleted += OnSyncDone;
        Sync.OnError += OnSyncError;

        await Db.InitAsync();
        Log($"DB init OK. IsLoggedIn={Api.IsLoggedIn} UserId={Api.CurrentUser?.Id ?? "null"}");
        await LoadData();
    }

    private async Task LoadData()
    {
        loading = true;
        _mapInitialized = false;
        StateHasChanged();

        try
        {
            var scouterId = Api.CurrentUser?.Id;
            Log($"LoadData start — scouterId={scouterId ?? "null"}");

            var all = await Db.GetSessionsAsync(scouterId);
            Log($"GetSessionsAsync returned {all.Count} rows");

            activeSessions  = all.Where(s => s.Status == SessionStatus.Active && !s.IsPlanned).ToList();
            plannedSessions = all.Where(s => s.IsPlanned && !s.CompletedAt.HasValue).ToList();
            pendingSessions = all.Where(s => s.Status == SessionStatus.Completed && !s.IsPlanned).ToList();
            Log($"Buckets — active={activeSessions.Count} planned={plannedSessions.Count} pending={pendingSessions.Count}");

            obsCounts = await Db.GetAllObservationCountsAsync();

            var allTraps = await Db.GetCachedTrapsAsync();
            locatedTraps = allTraps.Where(t => t.Latitude.HasValue && t.Longitude.HasValue).ToList();
            Log($"Traps total={allTraps.Count} located={locatedTraps.Count}");
        }
        catch (Exception ex)
        {
            Log($"ERROR: {ex.GetType().Name}: {ex.Message}");
#if DEBUG
            _debugExpanded = true;
#endif
        }

        loading = false;
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!loading && !_mapInitialized && locatedTraps.Count > 0)
        {
            _mapInitialized = true;
            _dotNetRef ??= DotNetObjectReference.Create(this);
            var pins = locatedTraps.Select(t => new
            {
                id        = t.Id,
                name      = t.Name,
                latitude  = t.Latitude!.Value,
                longitude = t.Longitude!.Value,
                isEnabled = t.IsEnabled
            });
            await JS.InvokeVoidAsync("initDashboardTrapMap", "dash-trap-map", pins, _dotNetRef);
        }
    }

    [JSInvokable]
    public async Task OnTrapSelected(string trapId)
    {
        selectedTrap = locatedTraps.FirstOrDefault(t => t.Id == trapId);
        await InvokeAsync(StateHasChanged);
    }

    private void ViewSelectedTrap()
    {
        if (selectedTrap is not null) Nav.NavigateTo($"/trap-detail/{selectedTrap.Id}");
    }

    private async Task SyncNow()
    {
        if (syncing || !Conn.IsOnline) return;
        syncing = true;
        syncError = null;
        syncStatus = "Syncing...";
        StateHasChanged();
        await Sync.SyncAsync();
        await LoadData();
        syncing = false;
        StateHasChanged();
    }

    private void OnConnChanged()
    {
        InvokeAsync(async () =>
        {
            if (Conn.IsOnline && pendingSessions.Count > 0)
            {
                await SyncNow();
            }
            StateHasChanged();
        });
    }

    private void OnSyncProgress(string msg)
    {
        syncStatus = msg;
        InvokeAsync(StateHasChanged);
    }

    private void OnSyncDone()
    {
        syncing = false;
        syncError = null;
        syncStatus = $"Last synced: {DateTime.Now:HH:mm}";
        _ = InvokeAsync(LoadData);
    }

    private void OnSyncError(string msg)
    {
        syncing = false;
        syncError = msg;
        _ = InvokeAsync(StateHasChanged);
    }

    private void StartNewSession()
    {
        Nav.NavigateTo("/new-session");
    }

    private void OpenSession(LocalSession s)
    {
        Nav.NavigateTo($"/session-detail/{s.Id}");
    }

    public void Dispose()
    {
        Conn.OnConnectivityChanged -= OnConnChanged;
        Sync.OnProgress -= OnSyncProgress;
        Sync.OnCompleted -= OnSyncDone;
        Sync.OnError -= OnSyncError;
        _dotNetRef?.Dispose();
    }
}
