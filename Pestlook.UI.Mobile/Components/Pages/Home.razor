@page "/"
@inject ApiClient Api
@inject NavigationManager Nav
@inject ConnectivityService Conn
@inject LocalDatabase Db

<div class="app-shell">
    <div class="app-body" style="display:flex;flex-direction:column;justify-content:center;padding:24px 20px 16px;">

        <!-- Logo -->
        <div style="text-align:center;margin-bottom:36px;">
            <div style="font-size:40px;margin-bottom:8px;">🐛</div>
            <div style="font-size:24px;font-weight:600;color:#fff;letter-spacing:-.02em;">Pestlook</div>
            <div style="font-size:12px;color:var(--text-dim);margin-top:4px;">Field Intelligence Platform</div>
        </div>

        <!-- Connectivity indicator -->
        <div style="text-align:center;margin-bottom:16px;">
            @if (Conn.IsOnline)
            {
                <span style="font-size:11px;color:var(--green);">● Online</span>
            }
            else
            {
                <span style="font-size:11px;color:var(--red);">● Offline</span>
            }
        </div>

        @if (!string.IsNullOrEmpty(error))
        {
            <div class="error-box">@error</div>
        }

        <!-- Email -->
        <div style="margin-bottom:14px;">
            <div class="sl" style="padding:0 0 6px;">Email</div>
            <input class="inp" type="email" placeholder="thabo@agri-wc.co.za" @bind="email" @bind:event="oninput" />
        </div>

        <!-- Password -->
        <div style="margin-bottom:22px;">
            <div class="sl" style="padding:0 0 6px;">Password</div>
            <input class="inp" type="password" placeholder="••••••••" @bind="password" @bind:event="oninput" @onkeydown="OnPasswordKeyDown" />
        </div>

        <!-- Sign in -->
        <button class="bp" style="width:100%;margin:0 0 12px;" @onclick="SignIn" disabled="@busy">
            @if (busy) { <span class="spinner-sm"></span> } Sign in
        </button>

        <div style="text-align:center;font-size:12px;color:var(--text-dim);">Forgot password?</div>
    </div>
</div>

@code {
    private string email = "";
    private string password = "";
    private string? error;
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        if (Api.IsLoggedIn)
        {
            Nav.NavigateTo("/home");
            return;
        }

        // Pre-fill saved credentials from secure storage
        email    = await SecureStorage.Default.GetAsync("saved_email")    ?? "";
        password = await SecureStorage.Default.GetAsync("saved_password") ?? "";

        // Offline auto-restore: if no internet but a session was previously saved, log in locally
        if (!Conn.IsOnline)
        {
            await Db.InitAsync();
            var saved = await Db.GetUserSessionAsync();
            if (saved is not null)
            {
                Api.RestoreFromLocalSession(saved);
                Nav.NavigateTo("/home");
            }
        }
    }

    private async Task OnPasswordKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SignIn();
    }

    private async Task SignIn()
    {
        if (string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(password))
        {
            error = "Please enter your email and password.";
            return;
        }
        error = null;
        busy = true;
        try
        {
            var result = await Api.LoginAsync(email, password);
            if (result.Success)
            {
                // Persist credentials securely for next launch
                await SecureStorage.Default.SetAsync("saved_email",    email);
                await SecureStorage.Default.SetAsync("saved_password", password);

                // Persist session so the scout can log in offline next time
                var user = Api.CurrentUser;
                if (user is not null)
                {
                    await Db.InitAsync();
                    await Db.SaveUserSessionAsync(new LocalUserSession
                    {
                        UserId     = user.Id,
                        Email      = user.Email,
                        FirstName  = user.FirstName,
                        LastName   = user.LastName,
                        TenantSlug = user.TenantSlug,
                        Roles      = string.Join(',', user.Roles),
                        SavedAt    = DateTime.UtcNow
                    });
                }
                Nav.NavigateTo("/home");
            }
            else
            {
                error = result.Message ?? "Login failed. Check your credentials.";
            }
        }
        catch (Exception ex)
        {
            error = $"Connection error: {ex.Message}";
        }
        finally { busy = false; }
    }
}
