@page "/"
@inject ApiClient Api
@inject NavigationManager Nav

<div class="app-shell">
    <div class="app-body" style="display:flex;flex-direction:column;justify-content:center;padding:24px 20px 16px;">

        <!-- Logo -->
        <div style="text-align:center;margin-bottom:36px;">
            <div style="font-size:40px;margin-bottom:8px;">🐛</div>
            <div style="font-size:24px;font-weight:600;color:#fff;letter-spacing:-.02em;">Pestlook</div>
            <div style="font-size:12px;color:var(--text-dim);margin-top:4px;">Field Intelligence Platform</div>
        </div>

        @if (!string.IsNullOrEmpty(error))
        {
            <div class="error-box">@error</div>
        }

        <!-- Email -->
        <div style="margin-bottom:14px;">
            <div class="sl" style="padding:0 0 6px;">Email</div>
            <input class="inp" type="email" placeholder="thabo@agri-wc.co.za" @bind="email" @bind:event="oninput" />
        </div>

        <!-- Password -->
        <div style="margin-bottom:22px;">
            <div class="sl" style="padding:0 0 6px;">Password</div>
            <input class="inp" type="password" placeholder="••••••••" @bind="password" @bind:event="oninput" @onkeydown="OnPasswordKeyDown" />
        </div>

        <!-- Sign in -->
        <button class="bp" style="width:100%;margin:0 0 12px;" @onclick="SignIn" disabled="@busy">
            @if (busy) { <span class="spinner-sm"></span> } Sign in
        </button>

        <div style="text-align:center;font-size:12px;color:var(--text-dim);">Forgot password?</div>

        <!-- Demo credentials -->
        <div style="margin-top:24px;padding:14px 16px;border-radius:10px;background:rgba(109,222,132,0.07);border:1px solid rgba(109,222,132,0.2);">
            <div style="font-size:12px;font-weight:600;color:var(--green);margin-bottom:10px;">🌿 Try the demo</div>
            <div style="display:flex;flex-direction:column;gap:8px;">
                <button type="button" style="display:flex;justify-content:space-between;align-items:center;background:none;border:none;padding:0;cursor:pointer;width:100%;"
                        @onclick="FillAdmin">
                    <span style="font-size:11px;color:var(--text-dim);">Admin (web &amp; mobile)</span>
                    <span style="font-size:11px;color:var(--green);text-decoration:underline;">admin@demofarm.co</span>
                </button>
                <button type="button" style="display:flex;justify-content:space-between;align-items:center;background:none;border:none;padding:0;cursor:pointer;width:100%;"
                        @onclick="FillScout">
                    <span style="font-size:11px;color:var(--text-dim);">Scout (mobile only)</span>
                    <span style="font-size:11px;color:var(--green);text-decoration:underline;">scout@demofarm.co</span>
                </button>
                <div style="font-size:10px;color:var(--text-dim);margin-top:2px;">Password: <strong style="color:var(--text);">Demo@1234!</strong> · tap to fill in</div>
            </div>
        </div>
    </div>
</div>

@code {
    private string email = "";
    private string password = "";
    private string? error;
    private bool busy;

    protected override void OnInitialized()
    {
        if (Api.IsLoggedIn) Nav.NavigateTo("/home");
    }

    private void FillAdmin()  { email = "admin@demofarm.co";  password = "Demo@1234!"; }
    private void FillScout()  { email = "scout@demofarm.co";  password = "Demo@1234!"; }

    private async Task OnPasswordKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SignIn();
    }

    private async Task SignIn()
    {
        if (string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(password))
        {
            error = "Please enter your email and password.";
            return;
        }
        error = null;
        busy = true;
        try
        {
            var result = await Api.LoginAsync(email, password);
            if (result.Success)
                Nav.NavigateTo("/home");
            else
                error = result.Message ?? "Login failed. Check your credentials.";
        }
        catch (Exception ex)
        {
            error = $"Connection error: {ex.Message}";
        }
        finally { busy = false; }
    }
}
