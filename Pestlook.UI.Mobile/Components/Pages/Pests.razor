@page "/pests"
@inject LocalDatabase Db
@inject NavigationManager Nav

<div class="app-shell">
    <div class="ab">
        <div style="width:32px;"></div>
        <span class="ab-title">Pest catalogue</span>
        <div style="width:32px;"></div>
    </div>

    <!-- Search -->
    <div class="srch">
        🔍 <input type="text" placeholder="Search pests…" @bind="searchText" @bind:event="oninput" />
    </div>

    <!-- Category filter chips -->
    <div class="chip-row">
        <span class="ch @(categoryFilter == null ? "cs" : "cn")" style="cursor:pointer;" @onclick="() => categoryFilter = null">All</span>
        <span class="ch @(categoryFilter == 0 ? "cs" : "cn")" style="cursor:pointer;" @onclick="() => categoryFilter = 0">Insects</span>
        <span class="ch @(categoryFilter == 1 ? "cs" : "cn")" style="cursor:pointer;" @onclick="() => categoryFilter = 1">Disease</span>
        <span class="ch @(categoryFilter == 2 ? "cs" : "cn")" style="cursor:pointer;" @onclick="() => categoryFilter = 2">Weeds</span>
        <span class="ch @(categoryFilter == 3 ? "cs" : "cn")" style="cursor:pointer;" @onclick="() => categoryFilter = 3">Vertebrate</span>
        <span style="width:4px;"></span>
        <span class="ch @(sourceFilter == null ? "ci" : "cn")" style="cursor:pointer;" @onclick="() => sourceFilter = null">All sources</span>
        <span class="ch @(sourceFilter == true ? "ci" : "cn")" style="cursor:pointer;" @onclick="() => sourceFilter = true">System</span>
        <span class="ch @(sourceFilter == false ? "ci" : "cn")" style="cursor:pointer;" @onclick="() => sourceFilter = false">Custom</span>
    </div>

    <div class="app-body">
        @if (loading)
        {
            <div class="loading-center"><span class="spinner-sm"></span> Loading...</div>
        }
        else if (FilteredPests.Count == 0)
        {
            <div style="text-align:center;padding:40px 20px;color:var(--text-dim);">
                <div style="font-size:28px;margin-bottom:8px;">🦗</div>
                <div style="font-size:14px;">No pests found</div>
            </div>
        }
        else
        {
            @if (highPressure.Count > 0 && categoryFilter == null && sourceFilter == null && string.IsNullOrWhiteSpace(searchText))
            {
                <div class="sl">High pressure</div>
                @foreach (var p in highPressure)
                {
                    <div class="pest-card" style="border-color:rgba(224,96,96,.25);cursor:pointer;" @onclick="() => ViewPest(p)">
                        <div class="pest-icon" style="background:rgba(224,96,96,.1);">@PestEmoji(p.Category)</div>
                        <div style="flex:1;">
                            <div style="font-size:13px;font-weight:600;">@p.CommonName</div>
                            <div style="font-size:11px;color:var(--text-dim);font-style:italic;">@p.ScientificName</div>
                            <div style="display:flex;gap:4px;margin-top:4px;">
                                <span class="ch ce" style="font-size:9px;">High pressure</span>
                                <span class="ch cn" style="font-size:9px;">@CaptureModeLabel(p.DefaultCaptureMode)</span>
                            </div>
                        </div>
                        <div style="text-align:right;">
                            @if (p.AlertThreshold.HasValue)
                            {
                                <div style="font-size:16px;font-weight:600;color:var(--red);">@p.AlertThreshold</div>
                                <div style="font-size:9px;color:var(--text-dim);">threshold</div>
                            }
                        </div>
                    </div>
                }
            }

            <div class="sl">@(categoryFilter == null && sourceFilter == null && string.IsNullOrWhiteSpace(searchText) ? "All catalogue" : $"{FilteredPests.Count} results")</div>
            @foreach (var p in FilteredPests)
            {
                @if (!highPressure.Contains(p) || categoryFilter != null || sourceFilter != null || !string.IsNullOrWhiteSpace(searchText))
                {
                    <div class="pest-card" style="cursor:pointer;" @onclick="() => ViewPest(p)">
                        <div class="pest-icon" style="background:@IconBg(p.Category);">@PestEmoji(p.Category)</div>
                        <div style="flex:1;">
                            <div style="font-size:13px;font-weight:600;">@p.CommonName</div>
                            <div style="font-size:11px;color:var(--text-dim);font-style:italic;">@p.ScientificName</div>
                            <div style="display:flex;gap:4px;margin-top:4px;">
                                <span class="ch cn" style="font-size:9px;">@CategoryLabel(p.Category)</span>
                                <span class="ch cn" style="font-size:9px;">@CaptureModeLabel(p.DefaultCaptureMode)</span>
                                @if (p.IsSystemPest)
                                {
                                    <span class="ch ci" style="font-size:9px;">System</span>
                                }
                            </div>
                        </div>
                        <div style="text-align:right;min-width:32px;">
                            @{ var wk = WeekCount(p.Id); }
                            @if (wk > 0)
                            {
                                <div style="font-size:14px;font-weight:600;">@wk</div>
                                <div style="font-size:9px;color:var(--text-dim);">this wk</div>
                            }
                        </div>
                        <span style="font-size:14px;color:var(--text-dim);">›</span>
                    </div>
                }
            }
        }
    </div>

    <TabBar ActiveTab="pests" />
</div>

@code {
    private bool loading = true;
    private List<CachedPest> allPests = new();
    private List<CachedPest> highPressure = new();
    private List<LocalObservation> weekObservations = new();
    private string searchText = "";
    private int? categoryFilter;
    private bool? sourceFilter;

    private List<CachedPest> FilteredPests
    {
        get
        {
            var list = allPests.AsEnumerable();
            if (categoryFilter.HasValue)
                list = list.Where(p => p.Category == categoryFilter.Value);
            if (sourceFilter.HasValue)
                list = list.Where(p => p.IsSystemPest == sourceFilter.Value);
            if (!string.IsNullOrWhiteSpace(searchText))
                list = list.Where(p =>
                    p.CommonName.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                    (p.ScientificName?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false));
            return list.ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        allPests = await Db.GetCachedPestsAsync();
        highPressure = allPests.Where(p => p.AlertThreshold.HasValue).Take(2).ToList();

        // Load observations from the past 7 days for week counts
        var weekAgo = DateTime.UtcNow.AddDays(-7); // CreatedAt is stored in UTC
        var sessions = await Db.GetSessionsAsync();
        foreach (var s in sessions)
        {
            var obs = await Db.GetObservationsForSessionAsync(s.Id);
            weekObservations.AddRange(obs.Where(o => o.CreatedAt >= weekAgo && o.PestId is not null));
        }

        loading = false;
    }

    private int WeekCount(string pestId) =>
        weekObservations.Count(o => o.PestId == pestId);

    private void ViewPest(CachedPest pest)
    {
        Nav.NavigateTo($"/pest-detail/{pest.Id}");
    }

    private static string CategoryLabel(int cat) => cat switch
    {
        0 => "Insect", 1 => "Disease", 2 => "Weed", 3 => "Vertebrate", _ => "Other"
    };

    private static string CaptureModeLabel(int mode) => mode switch
    {
        0 => "Trap", 1 => "Visual", _ => "Other"
    };

    private static string PestEmoji(int cat) => cat switch
    {
        0 => "🦟", 1 => "🦠", 2 => "🌿", 3 => "🐀", _ => "❓"
    };

    private static string IconBg(int cat) => cat switch
    {
        0 => "rgba(224,96,96,.1)",
        1 => "rgba(240,168,64,.1)",
        2 => "rgba(109,222,132,.1)",
        3 => "rgba(96,168,224,.1)",
        _ => "rgba(255,255,255,.05)"
    };
}
