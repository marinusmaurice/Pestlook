@page "/point-detail/{SessionId}/{PointId}"
@inject LocalDatabase Db
@inject NavigationManager Nav

<div class="app-shell">
    <!-- App bar -->
    <div class="ab">
        <button class="ab-btn" @onclick="GoBack">← Back</button>
        <span class="ab-title">@(point?.Name ?? "Point")</span>
        <div style="width:40px;"></div>
    </div>

    <!-- GPS strip -->
    <div style="padding:7px 10px;display:flex;gap:6px;flex-wrap:wrap;border-bottom:.5px solid var(--border);flex-shrink:0;">
        <span class="ch cs">📍 @(point?.Latitude.ToString("F4") ?? "—"), @(point?.Longitude.ToString("F4") ?? "—")</span>
        @if (point is not null)
        {
            <span class="ch cn">@TypeIcon(point.PointType) @TypeLabel(point.PointType)@(!string.IsNullOrEmpty(point.TrapTypeName) ? $" · {point.TrapTypeName}" : "")</span>
        }
        @if (point?.GpsAccuracy.HasValue == true)
        {
            <span class="ch @(point.GpsAccuracy > 20 ? "cw" : "cn")">±@(point.GpsAccuracy.Value.ToString("F1"))m</span>
        }
    </div>

    <div class="app-body">
        <!-- Trap section (only for trap points) -->
        @if (point?.PointType == 0)
        {
            <div class="sl">Trap count</div>
            <div class="cd" style="padding:0;overflow:hidden;">
                <div style="padding:9px 12px;display:flex;align-items:center;gap:8px;border-bottom:.5px solid var(--border);">
                    <div style="flex:1;">
                        <div style="font-size:12px;font-weight:600;">🪤 Trap total</div>
                        <div style="font-size:10px;color:var(--text-dim);">This session</div>
                    </div>
                    <div class="cv">
                        <button class="cb" @onclick="() => { if (trapCount > 0) trapCount--; }">−</button>
                        <span class="cv-n" style="color:@(trapCount > 20 ? "var(--red)" : "var(--text)");">@trapCount</span>
                        <button class="cb" @onclick="() => trapCount++">+</button>
                    </div>
                </div>
                <div style="padding:6px 12px;display:flex;align-items:center;gap:6px;">
                    @if (pests.Count > 0)
                    {
                        <select style="flex:1;background:var(--surface2);border:.5px solid var(--border);border-radius:6px;padding:5px 8px;font-size:11px;color:var(--text);font-family:inherit;outline:none;" @bind="trapPestId">
                            @foreach (var p in pests)
                            {
                                <option value="@p.Id">@PestEmoji(p.Category) @p.CommonName</option>
                            }
                        </select>
                    }
                    else
                    {
                        <span style="flex:1;font-size:10px;color:var(--text-dim);">Loading pests…</span>
                    }
                    <button style="background:var(--green-glow);border:.5px solid rgba(109,222,132,.25);border-radius:6px;color:var(--green);font-size:11px;font-weight:500;cursor:pointer;font-family:inherit;padding:5px 10px;"
                            @onclick="RecordReading" disabled="@recordingSaving">
                        @if (recordingSaving) { <span class="spinner-sm" style="width:12px;height:12px;margin-right:4px;"></span> }Record ↵
                    </button>
                </div>
            </div>

            <!-- Reset trap -->
            <div style="margin:6px 10px;">
                <label style="display:flex;align-items:center;gap:8px;font-size:13px;color:var(--text-dim);cursor:pointer;">
                    <input type="checkbox" checked="@trapReset" @onchange="ToggleTrapReset" style="accent-color:var(--green);" />
                    Reset trap (cleared today)
                </label>
            </div>
        }

        <!-- Observations -->
        <div style="display:flex;align-items:center;justify-content:space-between;padding:12px 12px 4px;">
            <span class="sl" style="padding:0;">Observations</span>
            <button style="background:var(--green-glow);color:var(--green);border:.5px solid rgba(109,222,132,.25);border-radius:7px;padding:4px 10px;font-size:11px;font-weight:500;cursor:pointer;font-family:inherit;"
                    @onclick="AddObservation">+ Add obs</button>
        </div>

        @if (loading)
        {
            <div class="loading-center"><span class="spinner-sm"></span> Loading...</div>
        }
        else if (observations.Count == 0)
        {
            <div style="text-align:center;padding:30px 20px;color:var(--text-dim);">
                <div style="font-size:28px;margin-bottom:8px;">📋</div>
                <div style="font-size:13px;">No observations yet. Tap "+ Add obs"@(point?.PointType == 0 ? " or record a trap reading above" : "").</div>
            </div>
        }
        else
        {
            <div class="cd" style="padding:0;overflow:hidden;">
                @foreach (var obs in observations)
                {
                    <div class="obs-item" style="@(obs.IsUnknownPest ? "background:rgba(240,168,64,.06);" : "")">
                        <span style="font-size:17px;">@(obs.IsUnknownPest ? "❓" : "🦟")</span>
                        <div style="flex:1;">
                            <div style="font-size:13px;font-weight:600;@(obs.IsUnknownPest ? "color:var(--amber);" : "")">@(obs.IsUnknownPest ? "Unknown pest" : (obs.PestName ?? "—"))</div>
                            @if (!string.IsNullOrEmpty(obs.TrapName))
                            {
                                <div style="font-size:11px;color:var(--text-dim);">🪤 @obs.TrapName</div>
                            }
                            else if (!string.IsNullOrEmpty(obs.UnknownPestDescription))
                            {
                                <div style="font-size:11px;color:var(--text-dim);">"@obs.UnknownPestDescription"</div>
                            }
                            else if (!string.IsNullOrEmpty(obs.Notes))
                            {
                                <div style="font-size:11px;color:var(--text-dim);font-style:italic;">@obs.Notes</div>
                            }
                        </div>
                        @if (obs.CaptureMode == 0 && obs.Count.HasValue)
                        {
                            var pest = pests.FirstOrDefault(p => p.Id == obs.PestId);
                            var overThreshold = pest?.AlertThreshold > 0 && obs.Count > pest.AlertThreshold;
                            <span style="font-family:monospace;font-size:16px;font-weight:600;color:@(overThreshold ? "var(--red)" : "var(--text)");min-width:24px;text-align:right;">
                                @obs.Count @if (overThreshold) { <span style="font-size:10px;">⚠</span> }
                            </span>
                        }
                        else if (obs.CaptureMode == 1 && obs.IsPresent.HasValue)
                        {
                            <span class="ch @(obs.IsPresent.Value ? "cw" : "cn")">@(obs.IsPresent.Value ? "Present" : "Absent")</span>
                        }
                        <button style="background:none;border:none;color:var(--text-dim);cursor:pointer;font-size:14px;" @onclick="() => DeleteObs(obs)">🗑</button>
                    </div>
                }
            </div>
        }

        <!-- Photos & Notes -->
        <div class="dr" style="margin-top:4px;">
            <div class="cd" style="flex:1;text-align:center;margin:0;cursor:pointer;padding:9px;" @onclick="TakePhoto">
                <div style="font-size:17px;margin-bottom:2px;">📷</div>
                <div style="font-size:10px;color:var(--text-dim);">@photoCount photos</div>
            </div>
            <div class="cd" style="flex:1;text-align:center;margin:0;cursor:pointer;padding:9px;">
                <div style="font-size:17px;margin-bottom:2px;">📝</div>
                <div style="font-size:10px;color:var(--text-dim);">Add note</div>
            </div>
        </div>
    </div>

    <!-- Bottom -->
    <div style="padding:8px 10px;border-top:.5px solid var(--border);flex-shrink:0;">
        <button class="bp" style="margin:0;width:100%;" @onclick="SaveAndNext">Save point & next →</button>
    </div>
</div>

@code {
    [Parameter] public string SessionId { get; set; } = "";
    [Parameter] public string PointId { get; set; } = "";

    private bool loading = true;
    private LocalMonitoringPoint? point;
    private List<LocalObservation> observations = new();
    private List<CachedPest> pests = new();
    private int trapCount;
    private string trapPestId = "";
    private bool trapReset;
    private bool recordingSaving;
    private int photoCount;

    protected override async Task OnParametersSetAsync() => await LoadData();

    private async Task LoadData()
    {
        loading = true;
        StateHasChanged();

        await Db.InitAsync();
        point = await Db.GetPointAsync(PointId);
        observations = await Db.GetObservationsForPointAsync(PointId);
        pests = await Db.GetCachedPestsAsync();

        if (point is not null)
        {
            trapCount = point.TrapCount ?? 0;
            trapReset = point.TrapResetAt.HasValue;
        }

        if (pests.Count > 0 && string.IsNullOrEmpty(trapPestId))
            trapPestId = pests[0].Id;

        // Count photos across observations
        photoCount = 0;
        foreach (var obs in observations)
        {
            var photos = await Db.GetPhotosForObservationAsync(obs.Id);
            photoCount += photos.Count;
        }

        loading = false;
    }

    private async Task RecordReading()
    {
        if (point is null || string.IsNullOrEmpty(trapPestId)) return;

        recordingSaving = true;
        StateHasChanged();

        var pest = pests.FirstOrDefault(p => p.Id == trapPestId);

        var obs = new LocalObservation
        {
            MonitoringPointId = PointId,
            SessionId = SessionId,
            PestId = trapPestId,
            PestName = pest?.CommonName,
            CaptureMode = 0,
            Count = trapCount,
            CapturedLat = point.Latitude,
            CapturedLng = point.Longitude
        };

        await Db.SaveObservationAsync(obs);

        // Update trap count on point
        point.TrapCount = trapCount;
        await Db.SavePointAsync(point);

        recordingSaving = false;
        trapCount = 0;
        await LoadData();
    }

    private async Task ToggleTrapReset(ChangeEventArgs e)
    {
        if (point is null) return;
        trapReset = (bool)(e.Value ?? false);
        point.TrapResetAt = trapReset ? DateTime.UtcNow : null;
        await Db.SavePointAsync(point);
    }

    private void AddObservation()
    {
        Nav.NavigateTo($"/add-observation/{SessionId}/{PointId}");
    }

    private async Task DeleteObs(LocalObservation obs)
    {
        await Db.DeleteObservationAsync(obs.Id);
        await LoadData();
    }

    private async Task TakePhoto()
    {
        try
        {
            var result = await MediaPicker.CapturePhotoAsync();
            if (result is not null)
            {
                // Save photo to app data
                var destPath = Path.Combine(FileSystem.AppDataDirectory, $"photo_{Guid.NewGuid()}{Path.GetExtension(result.FileName)}");
                using var stream = await result.OpenReadAsync();
                using var dest = File.Create(destPath);
                await stream.CopyToAsync(dest);

                // Associate with the first observation or create placeholder
                var targetObs = observations.FirstOrDefault();
                if (targetObs is not null)
                {
                    await Db.SavePhotoAsync(new LocalObservationPhoto
                    {
                        ObservationId = targetObs.Id,
                        LocalFilePath = destPath
                    });
                    await LoadData();
                }
            }
        }
        catch { /* camera not available or permission denied */ }
    }

    private void SaveAndNext()
    {
        Nav.NavigateTo($"/points-list/{SessionId}");
    }

    private void GoBack()
    {
        Nav.NavigateTo($"/points-list/{SessionId}");
    }

    private static string TypeIcon(int pt) => pt switch { 0 => "🪤", _ => "👁" };
    private static string TypeLabel(int pt) => pt switch { 0 => "Trap", _ => "Random observation" };
    private static string PestEmoji(int cat) => cat switch { 0 => "🦟", 1 => "🦠", 2 => "🌿", 3 => "🐀", _ => "❓" };
}
