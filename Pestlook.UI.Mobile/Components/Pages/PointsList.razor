@page "/points-list/{SessionId}"
@inject ApiClient Api
@inject LocalDatabase Db
@inject GpsService Gps
@inject ConnectivityService Conn
@inject NavigationManager Nav
@implements IDisposable

<div class="app-shell">
    <!-- App bar -->
    <div class="ab">
        <button class="ab-btn" @onclick="GoHome">✕ End</button>
        <span class="ab-title">@(session?.FarmName ?? "Session")</span>
        <button class="ib" style="font-size:11px;" @onclick="AddPoint">⊕</button>
    </div>

    <!-- Session metadata strip -->
    <div class="meta-strip">
        <div class="meta-item">🌾 <span class="meta-val">@(session?.FarmName ?? "—")</span></div>
        <div class="meta-item">⏱ <span class="meta-val">@elapsed</span></div>
        @if (!string.IsNullOrEmpty(session?.WeatherCondition))
        {
            <div class="meta-item">@session.WeatherCondition</div>
        }
        @if (!Conn.IsOnline)
        {
            <div class="meta-item">
                <span style="color:var(--amber);">📡 Offline</span>
            </div>
        }
    </div>

    <!-- Progress -->
    <div style="padding:10px 12px 8px;border-bottom:.5px solid var(--border);">
        <div style="display:flex;justify-content:space-between;margin-bottom:5px;">
            <span style="font-size:13px;font-weight:600;">@doneCount of @points.Count points done</span>
            <span style="font-size:12px;color:var(--text-dim);">@(session?.Status == 0 ? "In progress" : session?.Status == 1 ? "Completed" : "Synced")</span>
        </div>
        <div class="pb"><div class="pb-fill" style="width:@progressPct%;"></div></div>
    </div>

    <div class="app-body">
        @if (loading)
        {
            <div class="loading-center"><span class="spinner-sm"></span> Loading points...</div>
        }
        else if (points.Count == 0)
        {
            <div style="text-align:center;padding:40px 20px;color:var(--text-dim);">
                <div style="font-size:32px;margin-bottom:8px;">🌱</div>
                <div style="font-size:14px;">No monitoring points yet</div>
                <div style="font-size:12px;margin-top:4px;">Tap ⊕ to add your first point</div>
            </div>
        }
        else
        {
            @foreach (var pt in points)
            {
                <div class="pt-rw" style="opacity:@(pt.IsDone ? "0.55" : "1");@(pt.IsCurrent ? "background:var(--green-glow);" : "")"
                     @onclick="() => OpenPoint(pt)">
                    <span style="font-size:14px;color:@(pt.IsDone ? "var(--text-dim)" : pt.IsCurrent ? "var(--green)" : "var(--text-dim)");">
                        @(pt.IsDone ? "✓" : pt.IsCurrent ? "▶" : "○")
                    </span>
                    <div style="flex:1;">
                        <div style="font-size:13px;font-weight:600;@(pt.IsCurrent ? "color:var(--green);" : "")">@(pt.Point.Name ?? "Point")</div>
                        <div style="font-size:11px;color:var(--text-dim);">@TypeIcon(pt.Point.PointType) @TypeLabel(pt.Point.PointType) · @pt.ObsCount obs</div>
                    </div>
                    @if (pt.DistanceMetres.HasValue)
                    {
                        <span style="font-size:10px;color:var(--text-dim);font-family:monospace;">@FormatDistance(pt.DistanceMetres.Value)</span>
                    }
                    <span class="ch @(pt.IsDone ? "cn" : pt.IsCurrent ? "ce" : "cn")">@(pt.IsDone ? "Done" : pt.IsCurrent ? "Current" : "Pending")</span>
                </div>
            }
        }
    </div>

    <!-- Bottom buttons -->
    <div style="padding:8px 10px;border-top:.5px solid var(--border);display:flex;gap:6px;flex-shrink:0;">
        @if (session?.Status == 0)
        {
            <button class="bo" style="color:var(--text-dim);border-color:var(--border);" @onclick="GoHome">End session</button>
            @if (!loading && points.Count == 0)
            {
                <button class="bo" style="flex:2;color:var(--green);border-color:rgba(109,222,132,.25);" @onclick="AddPoint">Add point ⊕</button>
            }
            else if (!loading && totalObsCount > 0)
            {
                <button class="bp" style="flex:2;margin:0;" @onclick="CompleteSession" disabled="@completing">
                    @if (completing) { <span class="spinner-sm"></span> } ✓ Complete session
                </button>
            }
            else
            {
                <button class="bo" style="flex:2;color:var(--green);border-color:rgba(109,222,132,.25);" @onclick="OpenCurrentPoint" disabled="@loading">Open current →</button>
            }
        }
        else
        {
            <div style="flex:1;text-align:center;padding:8px;font-size:12px;color:var(--text-dim);">Session @(session?.Status == 2 ? "synced" : "completed") — read only</div>
        }
    </div>
</div>

@code {
    [Parameter] public string SessionId { get; set; } = "";

    private LocalSession? session;
    private bool loading = true;
    private bool completing;
    private List<PointItem> points = new();
    private int doneCount;
    private int totalObsCount;
    private int progressPct;
    private string elapsed = "0:00";
    private System.Threading.Timer? _timer;

    protected override async Task OnParametersSetAsync() => await LoadPoints();

    private async Task LoadPoints()
    {
        loading = true;
        StateHasChanged();

        await Db.InitAsync();
        session = await Db.GetSessionAsync(SessionId);

        var allPoints = await Db.GetPointsForSessionAsync(SessionId);
        var allObs = await Db.GetObservationsForSessionAsync(SessionId);

        // Get current GPS for proximity sorting
        await Gps.StartListeningAsync();

        points.Clear();
        bool foundCurrent = false;
        foreach (var p in allPoints)
        {
            var obsForPoint = allObs.Where(o => o.MonitoringPointId == p.Id).ToList();
            bool done = obsForPoint.Count > 0;
            bool current = !done && !foundCurrent && session?.Status == 0;
            if (current) foundCurrent = true;

            double? dist = null;
            if (Gps.HasFix && p.Latitude != 0 && p.Longitude != 0)
                dist = GpsService.DistanceMetres(Gps.Latitude!.Value, Gps.Longitude!.Value, p.Latitude, p.Longitude);

            points.Add(new PointItem
            {
                Point = p,
                IsDone = done,
                IsCurrent = false,
                ObsCount = obsForPoint.Count,
                DistanceMetres = dist
            });
        }

        // Sort by GPS proximity (nearest first), then mark current
        if (Gps.HasFix)
            points = points.OrderBy(p => p.IsDone).ThenBy(p => p.DistanceMetres ?? double.MaxValue).ToList();

        // Mark the first incomplete as current
        var currentPt = points.FirstOrDefault(p => !p.IsDone);
        if (currentPt != null && session?.Status == 0)
            currentPt.IsCurrent = true;

        doneCount = points.Count(p => p.IsDone);
        totalObsCount = allObs.Count;
        progressPct = points.Count > 0 ? (int)(100.0 * doneCount / points.Count) : 0;
        loading = false;

        UpdateElapsed();
        _timer ??= new System.Threading.Timer(_ => InvokeAsync(() => { UpdateElapsed(); StateHasChanged(); }), null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }

    private void UpdateElapsed()
    {
        if (session is null) return;
        var span = DateTime.UtcNow - session.StartedAt;
        elapsed = span.TotalHours >= 1
            ? $"{(int)span.TotalHours}:{span.Minutes:D2}:{span.Seconds:D2}"
            : $"{span.Minutes}:{span.Seconds:D2}";
    }

    private void OpenPoint(PointItem pt)
    {
        if (session?.Status != 0) return; // Completed/synced sessions are locked
        Nav.NavigateTo($"/point-detail/{SessionId}/{pt.Point.Id}");
    }

    private void OpenCurrentPoint()
    {
        var current = points.FirstOrDefault(p => p.IsCurrent) ?? points.FirstOrDefault(p => !p.IsDone);
        if (current != null) OpenPoint(current);
    }

    private async Task CompleteSession()
    {
        if (session is null) return;
        completing = true;
        StateHasChanged();

        session.CompletedAt = DateTime.UtcNow;
        session.Status = 1; // Completed
        await Db.SaveSessionAsync(session);

        // Complete on server if online and has remote id
        if (Conn.IsOnline && !string.IsNullOrEmpty(session.RemoteId) && Guid.TryParse(session.RemoteId, out var remoteId))
        {
            await Api.CompleteSessionAsync(remoteId);
        }

        completing = false;
        Nav.NavigateTo("/session-detail/" + SessionId);
    }

    private void GoHome()
    {
        Nav.NavigateTo("/home");
    }

    private void AddPoint()
    {
        Nav.NavigateTo($"/add-point/{SessionId}");
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }

    private static string TypeIcon(int pt) => pt switch { 0 => "🪤", _ => "👁" };
    private static string TypeLabel(int pt) => pt switch { 0 => "Trap", _ => "Random observation" };
    private static string FormatDistance(double m) => m < 1000 ? $"{m:F0}m" : $"{m / 1000:F1}km";

    private class PointItem
    {
        public LocalMonitoringPoint Point { get; set; } = null!;
        public bool IsDone { get; set; }
        public bool IsCurrent { get; set; }
        public int ObsCount { get; set; }
        public double? DistanceMetres { get; set; }
    }
}
