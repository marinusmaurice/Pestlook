@page "/session-detail/{SessionId}"
@inject ApiClient Api
@inject LocalDatabase Db
@inject NavigationManager Nav

<div class="app-shell">
    <!-- App bar -->
    <div class="ab">
        <button class="ab-btn" @onclick="GoBack">← Back</button>
        <span class="ab-title">Session detail</span>
        <div style="width:48px;"></div>
    </div>

    <div class="app-body">
        @if (loading)
        {
            <div class="loading-center"><span class="spinner-sm"></span> Loading...</div>
        }
        else if (session is null)
        {
            <div style="text-align:center;padding:40px 20px;color:var(--text-dim);font-size:13px;">Session not found</div>
        }
        else
        {
            <!-- Session info card -->
            <div class="cd" style="padding:0;overflow:hidden;">
                <div style="padding:10px 12px;display:flex;align-items:center;gap:8px;border-bottom:.5px solid var(--border);">
                    <span style="font-size:18px;">@StatusIcon</span>
                    <div style="flex:1;">
                        <div style="font-size:14px;font-weight:600;">@(session.FieldName ?? session.FarmName ?? "Session") · @session.StartedAt.ToLocalTime().ToString("d MMM yyyy")</div>
                        <div style="font-size:11px;color:var(--text-dim);">Started @session.StartedAt.ToLocalTime().ToString("HH:mm")</div>
                    </div>
                    <span class="ch @StatusChipClass">@StatusLabel</span>
                </div>
                @if (!string.IsNullOrEmpty(session.FarmName))
                {
                    <div class="sess-info-row">
                        <span style="color:var(--text-dim);font-size:12px;">Farm</span>
                        <span style="font-size:12px;font-weight:500;">@session.FarmName</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(session.FieldName))
                {
                    <div class="sess-info-row">
                        <span style="color:var(--text-dim);font-size:12px;">Field</span>
                        <span style="font-size:12px;font-weight:500;">@session.FieldName</span>
                    </div>
                }
                <div class="sess-info-row">
                    <span style="color:var(--text-dim);font-size:12px;">Duration</span>
                    <span style="font-size:12px;font-weight:500;">@Duration</span>
                </div>
                @if (session.CompletedAt.HasValue)
                {
                    <div class="sess-info-row">
                        <span style="color:var(--text-dim);font-size:12px;">Completed</span>
                        <span style="font-size:12px;font-weight:500;">@session.CompletedAt.Value.ToLocalTime().ToString("d MMM, HH:mm")</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(session.WeatherCondition) || session.Temperature != 0)
                {
                    <div class="sess-info-row">
                        <span style="color:var(--text-dim);font-size:12px;">Weather</span>
                        <span style="font-size:12px;font-weight:500;">@FormatWeather()</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(session.Notes))
                {
                    <div class="sess-info-row">
                        <span style="color:var(--text-dim);font-size:12px;">Notes</span>
                        <span style="font-size:12px;font-weight:500;max-width:180px;text-align:right;">@session.Notes</span>
                    </div>
                }
            </div>

            <!-- Weather edit (planned, not yet completed) -->
            @if (session.IsPlanned && !session.CompletedAt.HasValue)
            {
                <div class="cd" style="margin:4px 10px;padding:10px 12px;">
                    <div style="font-size:12px;font-weight:600;color:var(--text-dim);margin-bottom:8px;">Weather condition</div>
                    <div class="wx-row">
                        <button class="wx-btn @(editWeather == "Sunny"  ? "on" : "")" @onclick='() => SaveWeatherField("Sunny")'><span class="wx-icon">☀️</span><span class="wx-lbl">Sunny</span></button>
                        <button class="wx-btn @(editWeather == "Cloudy" ? "on" : "")" @onclick='() => SaveWeatherField("Cloudy")'><span class="wx-icon">☁️</span><span class="wx-lbl">Cloudy</span></button>
                        <button class="wx-btn @(editWeather == "Rainy"  ? "on" : "")" @onclick='() => SaveWeatherField("Rainy")'><span class="wx-icon">🌧️</span><span class="wx-lbl">Rainy</span></button>
                        <button class="wx-btn @(editWeather == "Windy"  ? "on" : "")" @onclick='() => SaveWeatherField("Windy")'><span class="wx-icon">💨</span><span class="wx-lbl">Windy</span></button>
                    </div>
                    <div style="font-size:12px;font-weight:600;color:var(--text-dim);margin:10px 0 6px;">Temperature (@TempUnit°)</div>
                    <div style="display:flex;align-items:center;gap:14px;">
                        <button class="cb" style="width:44px;height:44px;font-size:22px;" @onclick="DecrementTemperature">−</button>
                        <div style="text-align:center;min-width:60px;">
                            <span style="font-size:32px;font-weight:600;">@editTemperature°</span>
                        </div>
                        <button class="cb" style="width:44px;height:44px;font-size:22px;" @onclick="IncrementTemperature">+</button>
                    </div>
                </div>
            }

            <!-- Stats -->
            <div class="sess-card" style="margin:6px 10px;cursor:default;">
                <div class="sess-stats">
                    <div class="sess-stat">
                        <div style="font-size:18px;font-weight:600;">@observations.Count</div>
                        <div style="font-size:10px;color:var(--text-dim);">Observations</div>
                    </div>
                    @if (session.IsPlanned)
                    {
                        <div class="sess-stat">
                            <div style="font-size:18px;font-weight:600;">@groups.Count</div>
                            <div style="font-size:10px;color:var(--text-dim);">Groups</div>
                        </div>
                        <div class="sess-stat">
                            <div style="font-size:18px;font-weight:600;">@scoutedCount / @observations.Count</div>
                            <div style="font-size:10px;color:var(--text-dim);">Scouted</div>
                        </div>
                    }
                    else
                    {
                        <div class="sess-stat">
                            <div style="font-size:18px;font-weight:600;@(alertCount > 0 ? "color:var(--red);" : "")">@alertCount</div>
                            <div style="font-size:10px;color:var(--text-dim);">Alerts</div>
                        </div>
                    }
                </div>
            </div>

            <!-- Observations section header + view toggle -->
            <div style="display:flex;align-items:center;padding:6px 10px 2px;">
                <span class="sl" style="flex:1;margin:0;padding:0;">Observations</span>
                @if (session.IsPlanned && observations.Count > 0)
                {
                    <div class="seg" style="flex:0 0 auto;">
                        <button class="seg-btn @(!groupedView ? "on" : "")" @onclick='() => groupedView = false'>All (@observations.Count)</button>
                        <button class="seg-btn @(groupedView ? "on" : "")" @onclick='() => groupedView = true'>Groups (@groups.Count)</button>
                    </div>
                }
            </div>

            @if (observations.Count == 0)
            {
                <div style="text-align:center;padding:24px;color:var(--text-dim);">
                    <div style="font-size:28px;margin-bottom:8px;">📋</div>
                    <div style="font-size:13px;">No observations recorded</div>
                </div>
            }
            else if (groupedView && session.IsPlanned)
            {
                <!-- ── Grouped view ── -->
                @foreach (var g in groups)
                {
                    <div class="cd" style="margin:4px 10px;padding:0;overflow:hidden;">
                        <!-- Group header row -->
                        <div style="display:flex;align-items:center;gap:8px;padding:10px 12px;cursor:pointer;@(g.IsAlert ? "background:rgba(224,96,96,.06);" : "")"
                             @onclick="() => g.Expanded = !g.Expanded">
                            <span style="font-size:16px;">@(g.IsUnknownPest ? "❓" : "🦟")</span>
                            <div style="flex:1;">
                                <div style="font-size:13px;font-weight:600;@(g.IsUnknownPest ? "color:var(--amber);" : g.IsAlert ? "color:var(--red);" : "")">@g.PestName</div>
                                <div style="font-size:11px;color:var(--text-dim);">@CaptureModeLabel(g.CaptureMode) · @g.Total points</div>
                            </div>
                            <span class="ch @(g.ScoutedCount == g.Total ? "cs" : g.ScoutedCount > 0 ? "cw" : "cn")"
                                  style="min-width:44px;text-align:center;font-variant-numeric:tabular-nums;">
                                @g.ScoutedCount / @g.Total
                            </span>
                            @if (g.IsAlert) { <span style="font-size:14px;">⚠</span> }
                            <span style="color:var(--text-dim);font-size:12px;margin-left:2px;">@(g.Expanded ? "▲" : "▼")</span>
                        </div>

                        <!-- Individual observation rows -->
                        @if (g.Expanded)
                        {
                            @foreach (var obs in g.Items)
                            {
                                <div class="obs-item" style="border-top:.5px solid var(--border);padding-left:36px;cursor:pointer;"
                                     @onclick="() => ViewObservation(obs)">
                                    <div style="flex:1;">
                                        <div style="font-size:12px;font-weight:500;">Point #@(obs.SortOrder + 1)</div>
                                        <div style="font-size:11px;color:var(--text-dim);">@obs.CreatedAt.ToLocalTime().ToString("HH:mm")</div>
                                    </div>
                                    @if (obs.CaptureMode == 0)
                                    {
                                        @if (obs.Count.HasValue)
                                        {
                                            <span style="font-family:monospace;font-size:15px;font-weight:600;@(obs.ThresholdCount.HasValue && obs.Count.Value >= obs.ThresholdCount.Value ? "color:var(--red);" : "")">@obs.Count</span>
                                        }
                                        else
                                        {
                                            <span style="font-size:12px;color:var(--text-dim);">—</span>
                                        }
                                    }
                                    else if (obs.CaptureMode == 1)
                                    {
                                        @if (obs.IsPresent.HasValue)
                                        {
                                            <span class="ch @(obs.IsPresent.Value ? "cw" : "cn")">@(obs.IsPresent.Value ? "Yes" : "No")</span>
                                        }
                                        else
                                        {
                                            <span style="font-size:12px;color:var(--text-dim);">—</span>
                                        }
                                    }
                                    @if (!obs.IsPlanned && session?.Status == SessionStatus.Active)
                                    {
                                        <button style="background:none;border:none;padding:4px 6px;color:var(--red);font-size:16px;cursor:pointer;" @onclick:stopPropagation @onclick="() => DeleteObservation(obs)">🗑</button>
                                    }
                                    else
                                    {
                                        <span style="color:var(--text-dim);font-size:13px;">›</span>
                                    }
                                </div>
                            }
                        }
                    </div>
                }
            }
            else
            {
                <!-- ── Flat view ── -->
                <div class="cd" style="padding:0;overflow:hidden;">
                    @foreach (var obs in observations)
                    {
                        <div class="obs-item" style="cursor:pointer;@(obs.IsUnknownPest ? "background:rgba(240,168,64,.06);" : "")"
                             @onclick="() => ViewObservation(obs)">
                            <span style="font-size:16px;">@(obs.IsUnknownPest ? "❓" : "🦟")</span>
                            <div style="flex:1;">
                                <div style="font-size:12px;font-weight:600;@(obs.IsUnknownPest ? "color:var(--amber);" : "")">@DisplayName(obs)</div>
                                <div style="font-size:10px;color:var(--text-dim);">@obs.CreatedAt.ToLocalTime().ToString("HH:mm") · @CaptureModeLabel(obs.CaptureMode)</div>
                            </div>
                            @if (obs.Count.HasValue)
                            {
                                <span style="font-family:monospace;font-size:15px;font-weight:600;min-width:24px;text-align:right;@(obs.ThresholdCount.HasValue && obs.Count.Value >= obs.ThresholdCount.Value ? "color:var(--red);" : "")">@obs.Count</span>
                            }
                            else if (obs.IsPresent.HasValue)
                            {
                                <span class="ch @(obs.IsPresent.Value ? "cw" : "cn")">@(obs.IsPresent.Value ? "Yes" : "No")</span>
                            }
                            @if (!obs.IsPlanned && session?.Status == SessionStatus.Active)
                            {
                                <button style="background:none;border:none;padding:4px 6px;color:var(--red);font-size:16px;cursor:pointer;" @onclick:stopPropagation @onclick="() => DeleteObservation(obs)">🗑</button>
                            }
                            else
                            {
                                <span style="color:var(--text-dim);font-size:13px;">›</span>
                            }
                        </div>
                    }
                </div>
            }
        }
    </div>

    <!-- End session confirmation dialog -->
    @if (showEndDialog)
    {
        <div style="position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:200;display:flex;align-items:flex-end;justify-content:center;" @onclick="() => showEndDialog = false">
            <div style="background:var(--surface);border-radius:16px 16px 0 0;width:100%;max-width:480px;padding:20px 16px 32px;" @onclick:stopPropagation>
                <div style="width:36px;height:4px;background:var(--border);border-radius:2px;margin:0 auto 16px;"></div>
                <div style="font-size:16px;font-weight:700;margin-bottom:10px;">⚠️ End session?</div>
                @foreach (var msg in endDialogMessages)
                {
                    <div style="font-size:13px;color:var(--amber);margin-bottom:6px;">• @msg</div>
                }
                <div style="font-size:13px;color:var(--text-dim);margin-top:10px;margin-bottom:20px;">Are you sure you want to end this session?</div>
                <div style="display:flex;gap:8px;">
                    <button class="bo" style="flex:1;margin:0;" @onclick="() => showEndDialog = false">Cancel</button>
                    <button class="bo" style="flex:1;margin:0;color:var(--red);border-color:rgba(224,96,96,.25);" @onclick="ConfirmEndSession" disabled="@ending">
                        @if (ending) { <span class="spinner-sm" style="width:12px;height:12px;margin-right:4px;"></span> } End session
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- Bottom actions -->
    @if (session is not null)
    {
        <div style="padding:8px 10px;border-top:.5px solid var(--border);display:flex;gap:6px;flex-shrink:0;">
            @if (session.Status == SessionStatus.Active && !session.IsPlanned)
            {
                <button class="bo" style="flex:2;color:var(--green);border-color:rgba(109,222,132,.25);" @onclick="AddObservation">+ Add observation</button>
                <button class="bo" style="color:var(--red);border-color:rgba(224,96,96,.25);" @onclick="EndSession">End session</button>                
            }
            else if (session.IsPlanned && !session.CompletedAt.HasValue)
            {
                <button class="bo" style="flex:1;color:var(--green);border-color:rgba(109,222,132,.25);" @onclick="AddObservation">+ Add observation</button>
                <button class="bo" style="color:var(--red);border-color:rgba(224,96,96,.25);" @onclick="EndSession">End session</button>
            }
            else
            {
                <button class="bp" style="margin:0;width:100%;" @onclick="GoBack">← Back to sessions</button>
            }
        </div>
    }
</div>

@code {
    [Parameter] public string SessionId { get; set; } = "";

    private bool loading = true;
    private bool ending;
    private bool showEndDialog;
    private List<string> endDialogMessages = new();
    private LocalSession? session;
    private List<LocalObservation> observations = new();
    private List<ObsGroup> groups = new();
    private int alertCount;
    private int scoutedCount;
    private bool groupedView = true;
    private string editWeather = "";
    private int editTemperature;

    private string StatusIcon => session?.Status switch { SessionStatus.Synced => "☁️", SessionStatus.Completed => "✅", _ => session?.IsPlanned == true ? "📋" : "🌾" };
    private string StatusLabel => session?.Status switch { SessionStatus.Synced => "☁ Synced", SessionStatus.Completed => "✓ Completed", _ => session?.IsPlanned == true ? "Planned" : "● Active" };
    private string StatusChipClass => session?.Status switch { SessionStatus.Synced => "ci", SessionStatus.Completed => "cs", _ => session?.IsPlanned == true ? "cw" : "ce" };
    private string TempUnit => Api.CurrentUser?.TemperatureUnit ?? "C";

    private string FormatWeather()
    {
        var parts = new List<string>();
        if (!string.IsNullOrEmpty(session?.WeatherCondition))
            parts.Add(session.WeatherCondition);
        if (session?.Temperature is not 0)
        {
            if (TempUnit == "F")
                parts.Add($"{(int)(session!.Temperature * 9.0 / 5.0 + 32)}°F");
            else
                parts.Add($"{session!.Temperature}°C");
        }
        return parts.Count > 0 ? string.Join(" · ", parts) : "—";
    }

    private string Duration
    {
        get
        {
            if (session is null) return "—";
            var start = session.StartedAt != default ? session.StartedAt : (session.ScheduledDate ?? DateTime.UtcNow);
            var end = session.CompletedAt ?? DateTime.UtcNow;
            var span = end - start;
            return span.TotalHours >= 1 ? $"{(int)span.TotalHours}h {span.Minutes}m" : $"{(int)span.TotalMinutes}m";
        }
    }

    protected override async Task OnParametersSetAsync() => await LoadData();

    private async Task LoadData()
    {
        loading = true;
        StateHasChanged();

        session = await Db.GetSessionAsync(SessionId);
        observations = await Db.GetObservationsForSessionAsync(SessionId);

        alertCount = observations.Count(o => o.ThresholdCount.HasValue && o.Count.HasValue && o.Count.Value >= o.ThresholdCount.Value);
        scoutedCount = observations.Count(o =>
            (o.CaptureMode == 0 && o.Count.HasValue) ||
            (o.CaptureMode == 1 && o.IsPresent.HasValue));

        // Build groups for planned sessions
        groups = observations
            .Where(o => o.ObservationGroupId is not null)
            .GroupBy(o => o.ObservationGroupId!)
            .Select(g =>
            {
                var ordered = g.OrderBy(o => o.SortOrder).ToList();
                var first = ordered[0];
                var scouted = ordered.Count(o =>
                    (o.CaptureMode == 0 && o.Count.HasValue) ||
                    (o.CaptureMode == 1 && o.IsPresent.HasValue));
                return new ObsGroup
                {
                    GroupId      = g.Key,
                    PestName     = first.IsUnknownPest ? "Unknown pest" : (first.PestName ?? "—"),
                    IsUnknownPest= first.IsUnknownPest,
                    CaptureMode  = first.CaptureMode,
                    Total        = ordered.Count,
                    ScoutedCount = scouted,
                    IsAlert      = ordered.Any(o => o.ThresholdCount.HasValue && o.Count.HasValue && o.Count.Value >= o.ThresholdCount.Value),
                    Items        = ordered,
                    Expanded     = false
                };
            })
            .ToList();

        // Ungrouped observations each appear as a single-item group (always expanded)
        foreach (var obs in observations.Where(o => o.ObservationGroupId is null))
        {
            groups.Add(new ObsGroup
            {
                GroupId       = null,
                PestName      = obs.IsUnknownPest ? "Unknown pest" : (obs.PestName ?? "—"),
                IsUnknownPest = obs.IsUnknownPest,
                CaptureMode   = obs.CaptureMode,
                Total         = 1,
                ScoutedCount  = (obs.CaptureMode == 0 && obs.Count.HasValue) || (obs.CaptureMode == 1 && obs.IsPresent.HasValue) ? 1 : 0,
                IsAlert       = obs.ThresholdCount.HasValue && obs.Count.HasValue && obs.Count.Value >= obs.ThresholdCount.Value,
                Items         = [obs],
                Expanded      = true
            });
        }

        groupedView = session?.IsPlanned == true;
        editWeather = session?.WeatherCondition ?? "";
        editTemperature = session?.Temperature ?? 0;
        loading = false;
    }

    private static string DisplayName(LocalObservation obs)
        => obs.IsUnknownPest ? "Unknown pest" : (obs.PestName ?? "—");

    private static string CaptureModeLabel(int captureMode) => captureMode switch
    {
        0 => "Count",
        1 => "Present / Absent",
        _ => "—"
    };

    private void ViewObservation(LocalObservation obs)
        => Nav.NavigateTo($"/obs-detail/{obs.Id}/{SessionId}");

    private async Task EndSession()
    {
        if (session is null) return;

        endDialogMessages = new();

        if (observations.Count == 0)
        {
            endDialogMessages.Add("This session has no observations recorded.");
        }
        else
        {
            var incomplete = observations.Count(o =>
                (o.CaptureMode == 0 && !o.Count.HasValue) ||
                (o.CaptureMode == 1 && !o.IsPresent.HasValue));
            if (incomplete > 0)
                endDialogMessages.Add($"{incomplete} of {observations.Count} observation{(observations.Count == 1 ? "" : "s")} still {(incomplete == 1 ? "needs" : "need")} data captured.");
        }

        if (endDialogMessages.Count > 0)
        {
            showEndDialog = true;
            return;
        }

        await ConfirmEndSession();
    }

    private async Task ConfirmEndSession()
    {
        if (session is null) return;
        ending = true;
        StateHasChanged();
        session.Status = SessionStatus.Completed;
        session.CompletedAt = DateTime.UtcNow;
        await Db.SaveSessionAsync(session);
        ending = false;
        showEndDialog = false;
        Nav.NavigateTo("/sessions");
    }

    private void CancelWeatherEdit() { }

    private async Task SaveWeatherEdit()
    {
        if (session is null) return;
        session.WeatherCondition = editWeather;
        session.Temperature = editTemperature;
        await Db.SaveSessionAsync(session);
    }

    private async Task SaveWeatherField(string value)
    {
        if (session is null) return;
        editWeather = value;
        session.WeatherCondition = editWeather;
        session.Temperature = editTemperature;
        await Db.SaveSessionAsync(session);
    }

    private async Task DecrementTemperature()
    {
        if (editTemperature <= -30 || session is null) return;
        editTemperature--;
        session.Temperature = editTemperature;
        await Db.SaveSessionAsync(session);
    }

    private async Task IncrementTemperature()
    {
        if (editTemperature >= 60 || session is null) return;
        editTemperature++;
        session.Temperature = editTemperature;
        await Db.SaveSessionAsync(session);
    }

    private async Task DeleteObservation(LocalObservation obs)
    {
        await Db.DeleteObservationAsync(obs.Id);
        observations.Remove(obs);
        alertCount = observations.Count(o => o.ThresholdCount.HasValue && o.Count.HasValue && o.Count.Value >= o.ThresholdCount.Value);
        scoutedCount = observations.Count(o =>
            (o.CaptureMode == 0 && o.Count.HasValue) ||
            (o.CaptureMode == 1 && o.IsPresent.HasValue));
        groups.RemoveAll(g => g.Items.Contains(obs));
    }

    private void AddObservation()
        => Nav.NavigateTo($"/add-obs/{SessionId}");

    private void GoBack() => Nav.NavigateTo("/sessions");

    private sealed class ObsGroup
    {
        public string? GroupId { get; init; }
        public string PestName { get; init; } = "";
        public bool IsUnknownPest { get; init; }
        public int CaptureMode { get; init; }
        public int Total { get; init; }
        public int ScoutedCount { get; init; }
        public bool IsAlert { get; init; }
        public List<LocalObservation> Items { get; init; } = [];
        public bool Expanded { get; set; }
    }
}
