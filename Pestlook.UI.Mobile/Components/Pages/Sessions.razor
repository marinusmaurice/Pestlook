@page "/sessions"
@inject ApiClient Api
@inject NavigationManager Nav
@inject SyncService Sync
@inject LocalDatabase Db
@inject ConnectivityService Conn
@implements IDisposable

<div class="app-shell">
    <div class="ab">
        <div style="width:32px;"></div>
        <span class="ab-title">Sessions</span>
        <button class="bo" style="padding:5px 10px;font-size:12px;color:var(--green);border-color:rgba(109,222,132,.25);"
                @onclick="StartNew">+ New</button>
    </div>

    <!-- Filter tabs -->
    <div class="filter-tabs">
        <button class="filter-tab @(filter == "planned" ? "on" : "")" @onclick='() => filter = "planned"'>Planned (@planned.Count)</button>
        <button class="filter-tab @(filter == "active" ? "on" : "")" @onclick='() => filter = "active"'>Active (@active.Count)</button>
        <button class="filter-tab @(filter == "completed" ? "on" : "")" @onclick='() => filter = "completed"'>Completed (@completed.Count)</button>
    </div>

    <div class="app-body">
        @if (loading)
        {
            <div class="loading-center"><span class="spinner-sm"></span> Loading...</div>
        }
        else
        {
            @if (filter == "planned")
            {
                @if (planned.Count == 0)
                {
                    <div style="text-align:center;padding:40px 20px;color:var(--text-dim);">
                        <div style="font-size:28px;margin-bottom:8px;">📋</div>
                        <div style="font-size:14px;">No planned sessions</div>
                        <div style="font-size:12px;margin-top:4px;">Pull from server to load your plan</div>
                    </div>
                }
                else
                {
                    @foreach (var s in planned)
                    {
                        var locked = s.ScheduledDate.HasValue && s.ScheduledDate.Value > DateTime.UtcNow;
                        <div class="sess-card" style="border-color:@(locked ? "rgba(150,150,150,.15)" : "rgba(109,222,132,.15)");@(locked ? "opacity:.75;cursor:default;" : "")"
                             @onclick="() => { if (!locked) OpenSession(s); }">
                            <div class="sess-head" style="background:@(locked ? "rgba(150,150,150,.06)" : "var(--green-glow)");">
                                <span style="font-size:16px;">@(locked ? "🔒" : "📋")</span>
                                <div style="flex:1;">
                                    <div style="font-size:13px;font-weight:600;color:@(locked ? "var(--text-dim)" : "var(--green)");">@(s.FieldName ?? s.FarmName ?? "Planned session")</div>
                                    @if (locked)
                                    {
                                        <div style="font-size:11px;color:var(--text-dim);">Available @s.ScheduledDate!.Value.ToLocalTime().ToString("d MMM, HH:mm")</div>
                                    }
                                    else
                                    {
                                        <div style="font-size:11px;color:var(--text-dim);">@(s.ScheduledDate?.ToLocalTime().ToString("d MMM yyyy") ?? "Unscheduled")</div>
                                    }
                                </div>
                                @if (locked)
                                {
                                    <span class="ch" style="background:rgba(150,150,150,.12);color:var(--text-dim);">Locked</span>
                                }
                                else
                                {
                                    <span class="ch cw">Planned</span>
                                }
                            </div>
                            <div class="sess-stats">
                                <div class="sess-stat">
                                    <div style="font-size:16px;font-weight:600;">@obsCounts.GetValueOrDefault(s.Id)</div>
                                    <div style="font-size:10px;color:var(--text-dim);">Observations</div>
                                </div>
                            </div>
                        </div>
                    }
                }
            }

            @if (filter == "active")
            {
                @if (active.Count == 0)
                {
                    <div style="text-align:center;padding:40px 20px;color:var(--text-dim);">
                        <div style="font-size:28px;margin-bottom:8px;">🌾</div>
                        <div style="font-size:14px;">No active sessions</div>
                        <div style="font-size:12px;margin-top:4px;">Start a new session to begin scouting</div>
                    </div>
                }
                else
                {
                    @foreach (var s in active)
                    {
                        <div class="sess-card" style="border-color:rgba(109,222,132,.25);"
                             @onclick="() => OpenSession(s)">
                            <div class="sess-head" style="background:var(--green-glow);">
                                <span style="font-size:16px;">🌾</span>
                                <div style="flex:1;">
                                    <div style="font-size:13px;font-weight:600;color:var(--green);">@(s.FieldName ?? s.FarmName ?? "Session") · @s.StartedAt.ToLocalTime().ToString("d MMM")</div>
                                    <div style="font-size:11px;color:var(--text-dim);">Started @s.StartedAt.ToLocalTime().ToString("HH:mm")</div>
                                </div>
                                <span class="ch cs">● Live</span>
                            </div>
                            <div class="sess-stats">
                                <div class="sess-stat">
                                    <div style="font-size:16px;font-weight:600;">@obsCounts.GetValueOrDefault(s.Id)</div>
                                    <div style="font-size:10px;color:var(--text-dim);">Observations</div>
                                </div>
                                <div class="sess-stat">
                                    <div style="font-size:16px;font-weight:600;">@WeatherIcon(s.WeatherCondition)</div>
                                    <div style="font-size:10px;color:var(--text-dim);">@(s.WeatherCondition ?? "—")</div>
                                </div>
                            </div>
                        </div>
                    }
                }
            }

            @if (filter == "completed")
            {
                @if (completed.Count == 0)
                {
                    <div style="text-align:center;padding:40px 20px;color:var(--text-dim);">
                        <div style="font-size:28px;margin-bottom:8px;">✅</div>
                        <div style="font-size:14px;">No completed sessions</div>
                    </div>
                }
                else
                {
                    @foreach (var s in completed)
                    {
                        <div class="rw" style="cursor:pointer;" @onclick="() => OpenSession(s)">
                            <span style="font-size:15px;">🌻</span>
                            <div style="flex:1;">
                                <div style="font-size:13px;font-weight:600;">@(s.FieldName ?? s.FarmName ?? "Session") · @s.StartedAt.ToLocalTime().ToString("d MMM")</div>
                                <div style="font-size:11px;color:var(--text-dim);">@s.StartedAt.ToLocalTime().ToString("d MMM") · @obsCounts.GetValueOrDefault(s.Id) obs@(s.WeatherCondition != null ? $" · {s.WeatherCondition}" : "")</div>
                            </div>
                            @if (s.Status == SessionStatus.Synced)
                            {
                                <span class="ch cs">✓ Synced</span>
                            }
                            else
                            {
                                <span class="ch cw">Queued</span>
                            }
                        </div>
                    }
                }
            }
        }
    </div>

    <!-- Sync button -->
    <div style="padding:8px 10px;border-top:.5px solid var(--border);display:flex;flex-direction:column;align-items:center;">
        @if (syncError is not null)
        {
            <div style="font-size:11px;color:var(--red,#e87070);margin-bottom:6px;padding:6px 8px;background:rgba(232,112,112,.1);border-radius:6px;width:100%;text-align:center;">⚠ @syncError</div>
        }
        @if (Conn.IsOnline)
        {
            <button class="bp" style="min-width:140px;" @onclick="SyncNow" disabled="@syncing">
                @if (syncing)
                {
                    <span class="spinner-sm" style="width:14px;height:14px;margin-right:6px;"></span>
                    <span>@syncStatus</span>
                }
                else
                {
                    <span>⇅ Sync</span>
                }
            </button>
        }
        else
        {
            <div style="font-size:11px;color:var(--text-dim);text-align:center;">Offline — connect to sync</div>
        }
    </div>

    <TabBar ActiveTab="sessions" />
</div>

@code {
    private bool loading = true;
    private bool syncing;
    private string filter = "planned";
    private string syncStatus = "Syncing...";
    private string? syncError;
    private List<LocalSession> allSessions = new();
    private List<LocalSession> planned = new();
    private List<LocalSession> active = new();
    private List<LocalSession> completed = new();
    private Dictionary<string, int> obsCounts = new();

    protected override async Task OnInitializedAsync()
    {
        if (!Api.IsLoggedIn) { Nav.NavigateTo("/"); return; }
        await Db.InitAsync();
        Sync.OnProgress += OnSyncProgress;
        Sync.OnCompleted += OnSyncCompleted;
        Sync.OnError += OnSyncError;
        await LoadData();
    }

    private async Task LoadData()
    {
        loading = true;
        StateHasChanged();

        var all = await Db.GetSessionsAsync(Api.CurrentUser?.Id);
        allSessions = all;
        planned = all.Where(s => s.IsPlanned && !s.CompletedAt.HasValue).OrderBy(s => s.ScheduledDate).ToList();
        active = all.Where(s => !s.IsPlanned && !s.CompletedAt.HasValue).OrderByDescending(s => s.StartedAt).ToList();
        completed = all.Where(s => s.CompletedAt.HasValue).OrderByDescending(s => s.CompletedAt).ToList();

        obsCounts = await Db.GetAllObservationCountsAsync();

        loading = false;
        StateHasChanged();
    }

    private void OpenSession(LocalSession s)
        => Nav.NavigateTo($"/session-detail/{s.Id}");

    private void StartNew()
        => Nav.NavigateTo("/new-session");

    private async Task SyncNow()
    {
        if (syncing) return;
        syncing = true;
        syncError = null;
        syncStatus = "Syncing...";
        StateHasChanged();
        await Sync.SyncAsync();
        await LoadData();
        syncing = false;
        StateHasChanged();
    }

    private void OnSyncProgress(string msg) { syncStatus = msg; InvokeAsync(StateHasChanged); }
    private void OnSyncCompleted() { syncing = false; syncError = null; _ = InvokeAsync(LoadData); }
    private void OnSyncError(string msg) { syncing = false; syncError = msg; _ = InvokeAsync(StateHasChanged); }

    private static string WeatherIcon(string? condition) =>
        Pestlook.UI.Mobile.Components.Shared.WeatherSlider.States.FirstOrDefault(s => s.Name.Equals(condition, StringComparison.OrdinalIgnoreCase))?.Icon ?? "—";

    public void Dispose()
    {
        Sync.OnProgress -= OnSyncProgress;
        Sync.OnCompleted -= OnSyncCompleted;
        Sync.OnError -= OnSyncError;
    }
}
